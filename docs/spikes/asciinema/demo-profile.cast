[0.020, "o", "# screenz profile \"office\" — written by: screenz profile save office\r\n# Apply with:   screenz apply office\r\n# Preview with: screenz apply --dry-run office\r\nversion: 1\r\nname: office\r\nrules:\r\n  - match:\r\n      bundle: com.microsoft.VSCode\r\n      title: /office-demo/\r\n    display:\r\n      built-in: true\r\n    region: maximize\r\n  - match:\r\n      app: Google Chrome\r\n      title: /Example Domain/\r\n    display:\r\n      index: 1\r\n    region: left-half\r\n"]
