{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neozenith/screenz/adrs-okf-yml/adr.schema.json",
  "title": "screenz Architecture Decision Record",
  "description": "Structured form of the Lens template. Every prose field of the markdown record is a named key here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "slug", "plan_id", "title", "description", "status", "accepted_on",
    "last_changed_on", "tags", "lens", "provenance", "enforced_in", "relates_to",
    "problem", "decision", "consequences"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "plan_id": {
      "type": ["string", "null"],
      "pattern": "^ADR[1-6]\\.[0-9]+$",
      "description": "Planning-era identifier cited in code comments. Null for records accepted after the planning phase ended; ADR-0018 is the first."
    },
    "title": { "type": "string", "minLength": 10 },
    "description": {
      "type": "string", "minLength": 20, "maxLength": 140,
      "not": { "pattern": "\\.$" },
      "description": "One-line routing summary for the index and OKF frontmatter. Must not end in a full stop: it is a label, not a sentence. ADR-0015's description contains '~/.config', so this anchors to the end rather than banning the character. maxLength is 140 because the longest existing description (ADR-0019) is 124 — a measurement of this repo's dialect, not a target to write up to."
    },
    "status": { "enum": ["proposed", "accepted", "superseded", "retired"] },
    "accepted_on": { "type": "string", "format": "date" },
    "last_changed_on": { "type": "string", "format": "date" },
    "tags": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "lens": {
      "type": "string", "minLength": 20,
      "description": "The reusable rule. Read this to apply the decision."
    },
    "provenance": {
      "type": "string", "minLength": 10,
      "description": "The evidence the decision rests on."
    },
    "enforced_in": {
      "type": "array", "minItems": 1,
      "items": { "type": "string" },
      "description": "Packages and files where the decision is actually binding."
    },
    "relates_to": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation", "target"],
        "properties": {
          "relation": {
            "enum": [
              "extends", "extended_by",
              "split_from", "split_to",
              "supersedes", "superseded_by",
              "tests", "tested_by",
              "depends_on", "depended_on_by",
              "excepts", "excepted_by",
              "see_also"
            ]
          },
          "target": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
          "note": { "type": "string" }
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symptom", "pain_point"],
      "properties": {
        "symptom": { "type": "string", "minLength": 20 },
        "pain_point": { "type": "string", "minLength": 20 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["given", "we_prefer", "because", "unless", "in_practice"],
      "properties": {
        "given": { "type": "string", "minLength": 10 },
        "we_prefer": {
          "type": "string", "minLength": 10,
          "description": "Must name the rejected alternative; the template spells this 'X, over Y'."
        },
        "because": { "type": "string", "minLength": 10 },
        "unless": {
          "type": "string", "minLength": 5,
          "description": "The escape hatch, or 'never' when the decision is unconditional."
        },
        "in_practice": {
          "type": "array", "minItems": 1, "items": { "type": "string" }
        }
      }
    },
    "consequences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pros", "cons"],
      "properties": {
        "pros": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cons": {
          "type": "array", "minItems": 1, "items": { "type": "string" },
          "description": "A record with no cons has not been thought about."
        }
      }
    }
  }
}
