    {
      "data": {
        "id": "ADR-0001",
        "label": "0001",
        "parent": "area-6",
        "colour": "#7c3aed",
        "title": "Distribute via CI-built artifacts on the GitHub Releases page",
        "description": "Distribution machinery must match the audience that exists today",
        "plan_id": "ADR6.1",
        "status": "accepted",
        "tags": "distribution, release, ci"
      }
    },
    {
      "data": {
        "id": "ADR-0002",
        "label": "0002",
        "parent": "area-1",
        "colour": "#6366f1",
        "title": "Bridge to macOS through purego with CGO_ENABLED=0",
        "description": "Bind OS primitives through purego, CGO off; prove each symbol on real hardware first",
        "plan_id": "ADR1.1",
        "status": "accepted",
        "tags": "macos, ffi, build"
      }
    },
    {
      "data": {
        "id": "ADR-0003",
        "label": "0003",
        "parent": "area-1",
        "colour": "#6366f1",
        "title": "Fail loudly when Accessibility is not granted",
        "description": "Fail with the responsible party named; never report an empty world as success",
        "plan_id": "ADR1.2",
        "status": "accepted",
        "tags": "accessibility, errors"
      }
    },
    {
      "data": {
        "id": "ADR-0004",
        "label": "0004",
        "parent": "area-1",
        "colour": "#6366f1",
        "title": "Two test tiers; the integration tier fails, never skips",
        "description": "Pure coverage universal; the real seam tested on real hardware; a skip is a green lie",
        "plan_id": "ADR1.3",
        "status": "accepted",
        "tags": "testing, coverage"
      }
    },
    {
      "data": {
        "id": "ADR-0005",
        "label": "0005",
        "parent": "area-2",
        "colour": "#0891b2",
        "title": "Group windows by bundle id, not PID",
        "description": "Group by product identity (bundle id), never process identity",
        "plan_id": "ADR2.1",
        "status": "accepted",
        "tags": "discovery, identity"
      }
    },
    {
      "data": {
        "id": "ADR-0006",
        "label": "0006",
        "parent": "area-2",
        "colour": "#0891b2",
        "title": "Report windows the tool cannot act on instead of hiding them",
        "description": "Never hide what the tool cannot act on; incomplete enumeration fails the run",
        "plan_id": "ADR2.2",
        "status": "accepted",
        "tags": "discovery, errors"
      }
    },
    {
      "data": {
        "id": "ADR-0007",
        "label": "0007",
        "parent": "area-2",
        "colour": "#0891b2",
        "title": "Order display indexes by row, then left to right",
        "description": "Indexes follow the known ordering; stable identity is UUID or name",
        "plan_id": "ADR2.3",
        "status": "accepted",
        "tags": "discovery, displays, ordering"
      }
    },
    {
      "data": {
        "id": "ADR-0008",
        "label": "0008",
        "parent": "area-3",
        "colour": "#059669",
        "title": "Fail strictly on a mismatched frame, with a numeric tolerance",
        "description": "Verification is never off; widen numerically and deliberately",
        "plan_id": "ADR3.1",
        "status": "accepted",
        "tags": "placement, verification"
      }
    },
    {
      "data": {
        "id": "ADR-0009",
        "label": "0009",
        "parent": "area-3",
        "colour": "#059669",
        "title": "Never activate applications during a bulk apply",
        "description": "Bulk operations never fight the user for focus",
        "plan_id": "ADR3.2",
        "status": "accepted",
        "tags": "placement, focus"
      }
    },
    {
      "data": {
        "id": "ADR-0010",
        "label": "0010",
        "parent": "area-3",
        "colour": "#059669",
        "title": "Retry a mismatched frame three times with a 25 ms pause",
        "description": "Three attempts before judging a frame; retry, then once after 25 ms",
        "plan_id": "ADR3.3",
        "status": "accepted",
        "tags": "placement, verification"
      }
    },
    {
      "data": {
        "id": "ADR-0011",
        "label": "0011",
        "parent": "area-4",
        "colour": "#d97706",
        "title": "Each --match opens a rule; sibling flags bind to it",
        "description": "One quoting layer; the CLI grammar is the saved-profile grammar",
        "plan_id": "ADR4.1",
        "status": "accepted",
        "tags": "cli, rules, grammar"
      }
    },
    {
      "data": {
        "id": "ADR-0012",
        "label": "0012",
        "parent": "area-4",
        "colour": "#d97706",
        "title": "Spell regexes as /pattern/, terminated at the last slash",
        "description": "One regex spelling everywhere; remaining ambiguity fails loudly",
        "plan_id": "ADR4.2",
        "status": "accepted",
        "tags": "cli, rules, grammar"
      }
    },
    {
      "data": {
        "id": "ADR-0013",
        "label": "0013",
        "parent": "area-4",
        "colour": "#d97706",
        "title": "Use stdlib flag with a hand-rolled subcommand table",
        "description": "Stdlib parsing, hand-rolled dispatch; no CLI framework",
        "plan_id": "ADR4.3",
        "status": "accepted",
        "tags": "cli, dependencies"
      }
    },
    {
      "data": {
        "id": "ADR-0014",
        "label": "0014",
        "parent": "area-5",
        "colour": "#db2777",
        "title": "Use goccy/go-yaml so profile comments survive saves",
        "description": "Hand comments are user data; every write preserves them and survives interruption",
        "plan_id": "ADR5.1",
        "status": "accepted",
        "tags": "profiles, yaml, dependencies"
      }
    },
    {
      "data": {
        "id": "ADR-0015",
        "label": "0015",
        "parent": "area-5",
        "colour": "#db2777",
        "title": "Resolve the profile directory dotfiles-first",
        "description": "Config is dotfiles-first: env override, XDG, ~/.config; never a path with a space",
        "plan_id": "ADR5.2",
        "status": "accepted",
        "tags": "profiles, config"
      }
    },
    {
      "data": {
        "id": "ADR-0016",
        "label": "0016",
        "parent": "area-5",
        "colour": "#db2777",
        "title": "Profiles are authored from flags or the template, not captured",
        "description": "Automate the repeated task, not the rare one",
        "plan_id": "ADR5.3",
        "status": "accepted",
        "tags": "profiles, scope"
      }
    },
    {
      "data": {
        "id": "ADR-0017",
        "label": "0017",
        "parent": "area-6",
        "colour": "#7c3aed",
        "title": "The terminal app is the TCC client; no daemon mode",
        "description": "Shell-launched only; the terminal app owns the grant (split from 0001)",
        "plan_id": "ADR6.2",
        "status": "accepted",
        "tags": "macos, accessibility, distribution"
      }
    },
